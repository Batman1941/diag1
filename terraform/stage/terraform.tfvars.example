# =============================================================================
# terraform/stage/terraform.tfvars.example
#
# Skopiuj do terraform.tfvars i uzupełnij swoimi danymi:
#   cp terraform/stage/terraform.tfvars.example terraform/stage/terraform.tfvars
#
# WAŻNE: terraform.tfvars zawiera sekrety – NIE dodawaj do git!
#        Plik jest już zabezpieczony przez .gitignore.
# =============================================================================

# ── Projekt GCP ───────────────────────────────────────────────────────────────
project_id = "your-gcp-project-id"
region     = "europe-west4"

# ── Artifact Registry ─────────────────────────────────────────────────────────
repo_name = "diag1"

# ── Baza danych ───────────────────────────────────────────────────────────────
# Wskaż istniejącą bazę PostgreSQL dostępną z Cloud Run.
database_url = "postgresql+psycopg://diag1_user:<db-password>@<db-host>:5432/diag1"

# ── Vertex AI (zalecane: stały region danych) ─────────────────────────────────
vertex_location = "europe-west4"
vertex_model    = "gemini-2.5-flash"

# Gemini Developer API (opcjonalne, nieużywane w trybie AI_PROVIDER=vertex)
gemini_api_key = ""

# ── Domena i bezpieczeństwo ──────────────────────────────────────────────────
domain = "app.example.com"

# Obrazy budowane lokalnie i wypychane do Artifact Registry.
backend_image  = "europe-west4-docker.pkg.dev/your-gcp-project-id/diag1/backend:release-001"
frontend_image = "europe-west4-docker.pkg.dev/your-gcp-project-id/diag1/frontend:release-001"

# Opcjonalna ochrona hasłem wejścia do frontendu.
frontend_access_password = ""
frontend_access_cookie_secret = ""
frontend_access_session_ttl_hours = 12
