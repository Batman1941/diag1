# Backend configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/diag1
AI_PROVIDER=vertex

# Gemini Developer API (used when AI_PROVIDER=gemini or fallback in auto)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

# Vertex AI (recommended)
# If VERTEX_PROJECT_ID is empty, backend will try GOOGLE_CLOUD_PROJECT / ADC project.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=europe-west4
VERTEX_MODEL=gemini-2.5-flash
GOOGLE_APPLICATION_CREDENTIALS=

AI_TIMEOUT_SECONDS=120
SESSION_TTL_HOURS=24
CORS_ORIGINS=http://localhost:9517,http://localhost:9080
ADMIN_PASSWORD=<your-admin-password>
FRONTEND_ACCESS_PASSWORD=
FRONTEND_ACCESS_COOKIE_SECRET=
FRONTEND_ACCESS_SESSION_TTL_HOURS=12
